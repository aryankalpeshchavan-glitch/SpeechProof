{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "axes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "NOT_SUPPORTED"] },
          "applicable": { "type": "boolean" },
          "measured_value": { "type": "number" },
          "threshold": { "type": "number" },
          "confidence_interval": { "type": "array", "items": { "type": "number" } },
          "metadata": { "type": "object" }
        },
        "required": ["name", "status", "applicable"]
      }
    }
  },
  "required": ["axes"]
}
